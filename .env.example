# Local sandbox only. Never put real provider credentials in this file.
APP_ENV=development
DATABASE_URL=postgresql://aether:aether-local-only@db:5432/aether
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
DEPOSIT_WEBHOOK_SECRET=
ACQUIRER_WEBHOOK_SECRET=
DEV_CREDIT_ENABLED=1
DEV_CREDIT_TOKEN=replace-with-a-long-random-local-only-token
DEV_ACQUIRER_ENABLED=1

# Production gates. Keep unset until licensed-provider and counsel sign-off.
DATA_REGION=
REGULATORY_APPROVED=0
CUSTODY_PROVIDER=
CHAIN_PROVIDER=
SCREENING_PROVIDER=
KYC_AML_PROVIDER=
ONRAMP_PROVIDER=
ACQUIRER_PROVIDER=
PAYOUT_PROVIDER=
KMS_KEY_REFERENCE=
